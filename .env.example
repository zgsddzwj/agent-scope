APP_ENV=development
HOST=127.0.0.1
PORT=8000

AGENT_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
